# アーベル入退室システム 環境変数サンプル
# このファイルを .env にコピーして値を入れ、run.py から読み込む想定。
# 実値の入った .env は GitHub に絶対に上げないこと（.gitignore 済み）。

# サーバー
PORT=8000

# デモモード（1=LINE/SwitchBotの実認証なしで動作確認できる。公開運用では必ず 0）
DEMO_MODE=1

# LINE（LIFF / Messaging API）
# LIFF ID（LINE Developers コンソールで発行）
LIFF_ID=
# IDトークン検証用チャネルID（LIFFが属するプロバイダーのチャネルID）
LINE_CHANNEL_ID=
# Messaging API チャネルシークレット（Webhook署名検証用）
LINE_CHANNEL_SECRET=
# Messaging API チャネルアクセストークン（Reply送信・リンクトークン発行用）
LINE_CHANNEL_ACCESS_TOKEN=

# SwitchBot
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_LOCK_DEVICE_ID=

# 管理者（LINEユーザーIDをカンマ区切り。デモモードでは demo-admin が常に管理者）
ADMIN_LINE_USER_IDS=

# 動作パラメータ（管理画面の設定が優先される）
UNLOCK_COOLDOWN_SEC=30
AUTO_EXIT_HOURS=12
AUTO_EXIT_INTERVAL_SEC=600
